rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return request.auth.token.role;
    }
    
    match /equipment/{equipmentId} {
      allow read: if request.auth != null;
      allow write: if role() == "admin" || role() == "staff";
    }
    
    match /bookings/{bookingId} {
      allow read: if role() in ["admin", "staff", "warehouse"]
                  || (role() == "client" && resource.data.createdBy == request.auth.uid);
                  
      allow create: if role() in ["admin", "staff", "client"]
                    && request.resource.data.status == "Requested";
                    
      allow update: if role() in ["admin", "staff"]
                    && resource.data.status == "Requested"
                    && request.resource.data.status == "Requested"
                    && request.resource.data.equipmentRequested == resource.data.equipmentRequested;
                    
      allow delete: if false;
      
      match /items/{itemId} {
        allow read: if role() in ["admin", "staff", "warehouse"]
                    || (role() == "client" && get(/databases/$(database)/documents/bookings/$(bookingId)).data.createdBy == request.auth.uid);
        allow write: if false; // Cloud Functions via Admin SDK only
      }
    }
    
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid && !request.resource.data.keys().hasAny(['role', 'roleDisplay']);
    }
    
    match /auditLogs/{logId} {
      allow read: if role() in ["admin", "staff"];
      allow write: if false;
    }
  }
}
